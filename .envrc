# Load the reproducible development environment whenever this directory is
# entered. Run `direnv allow` once after cloning the repository.
use flake

# Keep compiler and build-script temporary files inside this checkout as well
# as the Cargo target directory. This is repeated here because direnv may not
# import a shellHook override of the pre-existing platform TMPDIR variable.
export NVIM_GPUI_TMP_DIR="$PWD/tmp"
mkdir -p "$NVIM_GPUI_TMP_DIR"
export TMPDIR="$NVIM_GPUI_TMP_DIR"
